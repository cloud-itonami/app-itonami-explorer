{
  "name": "@itonami/explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "cloud.itonami.explorer",
    "title": "Explorer",
    "storageKey": "itonami.explorer.v1",
    "storeId": "network.itonami.explorer"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.ts",
    "tauri": "tauri",
    "build:desktop": "node scripts/deploy-gate.mjs && npm run build && tauri build --no-bundle",
    "build:android": "node scripts/deploy-gate.mjs && sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
